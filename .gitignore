# =============== Standard Unity .gitignore ===============
/[Ll]ibrary/
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Asset meta check
# Do not ignore .meta files in Assets, but ignore temporary ones
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated files
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Visual Studio / Rider / IDE cache
.vscode/
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Save files / local data
**/apocarrot_account_save.json*
